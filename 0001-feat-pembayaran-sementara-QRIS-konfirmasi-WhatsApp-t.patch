+  // ---------- Pembayaran sementara: QRIS + konfirmasi WhatsApp ----------
+  // PAY_MODE: 'qris' = bayar manual lewat QRIS (pemilik kirim kode aktivasi setelah cek),
+  //           'midtrans' = otomatis lewat Midtrans (butuh akun Midtrans aktif).
+  var PAY_MODE = 'qris';
+  var WA_NOMOR = '6281339676599';
+  var QRIS_GAMBAR = 'qris.png';
+  var PAKET_INFO = {
+    harian: { nama: 'Paket 3 Hari', harga: 10000, hari: 3 },
+    mingguan: { nama: 'Paket Mingguan (7 Hari)', harga: 20000, hari: 7 },
+    bulanan: { nama: 'Paket Bulanan (30 Hari)', harga: 35000, hari: 30 }
+  };
+  function bukaQris(kode) {
+    var p = PAKET_INFO[kode];
+    if (!p) return;
+    var rp = 'Rp ' + p.harga.toLocaleString('id-ID');
+    $('qrisPaket').textContent = p.nama + ' - ' + rp;
+    var img = $('qrisImg');
+    if (!img.getAttribute('src')) img.src = QRIS_GAMBAR;
+    var pesan = 'Halo, saya guru ' + ((state.user && state.user.nama) || '') + '. Saya sudah membayar ' + p.nama + ' (' + rp + ') lewat QRIS. Mohon kode aktivasinya.';
+    $('qrisWa').href = 'https://wa.me/' + WA_NOMOR + '?text=' + encodeURIComponent(pesan);
+    $('qrisBox').hidden = false;
+    $('qrisBox').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+  }
+  $('qrisTutup').onclick = function () { $('qrisBox').hidden = true; };
+  if (PAY_MODE === 'qris') {
+    $('caraBayar').innerHTML = '<b style="color:var(--ink)">Cara mengaktifkan:</b><br>1. Pilih salah satu paket di bawah (mulai Rp 10.000 / 3 hari).<br>2. Scan QRIS yang muncul dan bayar sesuai nominal paket.<br>3. Tekan tombol WhatsApp untuk mengirim bukti bayar ke pemilik.<br>4. Masukkan kode aktivasi dari pemilik di kolom bawah.';
+    $('payHint').textContent = 'Pembayaran sementara lewat QRIS dan dikonfirmasi manual oleh pemilik via WhatsApp. Kode aktivasi dikirim setelah pembayaran dicek.';
+  }
+
